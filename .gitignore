.agents/

# Local benchmark scripts
bench_*.py

worktrees/

# Secret material — never commit, regardless of location. A too-narrow ignore
# rule is how keys leak; these broad patterns are the net.
.env*
!.env.example
*.env
!*.env.example
*.key
*.pem
**/server.key
